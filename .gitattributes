# Normalize line endings for cross-platform checkouts.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.rpy text eol=lf
*.rpyc binary
*.command text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
.env.example text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.db binary
