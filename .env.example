# 复制成 .env 后填写；.env 不会进版本库。
# M0 默认 mock：不需要任何 Key 就能玩。

# mock = 模板对白（离线可玩）；llm = 调真实模型（M1）
ATB_LLM_MODE=mock

# OpenAI 兼容接口。DeepSeek 官方：
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 可选：节奏/服务参数
ATB_TURN_BUDGET=12
ATB_PORT=8756
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# M2 导演：1=关键节点让 LLM 选事件；0=只用确定性打分
ATB_DIRECTOR=1
