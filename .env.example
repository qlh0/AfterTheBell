# ============================================================
# After the Bell - 本地配置
# 1) 复制本文件为 .env
# 2) 填写 LLM_API_KEY（必填，否则后端拒绝启动）
# 3) 不要把 .env 提交到 Git
# ============================================================

# llm = 正式游玩（需要 Key）；mock 仅用于自动化测试/离线开发
ATB_LLM_MODE=llm

# DeepSeek API Key：https://platform.deepseek.com/
# 必填。没有 Key 无法开始游戏。
LLM_API_KEY=

# OpenAI 兼容接口；默认 DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 可选：服务与节奏参数
ATB_HOST=127.0.0.1
ATB_PORT=8756
ATB_TURN_BUDGET=14
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# 导演：1=关键节点让 LLM 选事件；0=只用确定性打分
ATB_DIRECTOR=1

# 仅测试/离线开发使用：ATB_LLM_MODE=mock 时必须同时设为 1
# ATB_ALLOW_MOCK=0
